# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Voice priority: Gnani -> ElevenLabs -> OpenAI TTS -> browser
GNANI_API_KEY=
# GNANI_TTS_MODEL=timbre-v3.0  # Shivani is a v3.0 voice
# GNANI_VOICE=Shivani
# GNANI_SPEED=0.9             # 0.85 slowest to 1.15 fastest
# GNANI_LANGUAGE=en-IN       # or hi-en (Hinglish), auto
ELEVENLABS_API_KEY=
# Optional: an Indian-English voice from your ElevenLabs Voice Library (default is premade "Rachel")
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ANTHROPIC_API_KEY=          # if set, Claude is used as the brain instead of OpenAI
# KAM_MODEL=gpt-4.1-mini
# KAM_PROVIDER=openai|claude|offline
# KAM_TTS=gnani|elevenlabs|openai|browser
# GNANI_SELLER_VOICE=Avinash    # voice used for the seller in the auto demo (any timbre-v3.0 voice)
